# The project pins vite@8.0.14, but @tailwindcss/vite's declared peer range
# (^5.2.0 || ^6 || ^7) hasn't caught up to Vite 8 yet — this is a real,
# pre-existing gap in that package's peerDependencies metadata, not a bug in
# this project. It works fine in practice (Vite 8 is backward compatible
# here), so we tell npm to install anyway rather than hard-fail on a peer
# range that's simply out of date. Netlify's build image respects this file
# automatically.
legacy-peer-deps=true
